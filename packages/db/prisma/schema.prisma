generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// knowledge_chunks — a TUDÁSBÁZIS. Egy sor = egy chunk (a cikk egy darabja) + a vektora.
// A products tábla a TÉNYEKET tárolja (ár, készlet), ez a tábla a SZÖVEGES TUDÁST.
//
// Az `embedding` típusát a Prisma nem ismeri (Unsupported) — nem is baj: a vektorkeresés
// nyers SQL-ben történik (packages/core/src/lib/rag/knowledge-store.ts), a Prisma csak a
// táblát hozza létre. A `vector` extension létrehozása a migráció első sora, kézzel.
model KnowledgeChunk {
  id         Int                          @id @default(autoincrement())
  source     String // a cikk URL-je — EZT idézi vissza az agent (grounding)
  title      String
  category   String
  chunkIndex Int                          @map("chunk_index")
  content    String // maga a darab szövege — ezt kapja a modell
  embedding  Unsupported("vector(1536)")? // 1536 szám: a darab jelentése
  createdAt  DateTime                     @default(now()) @map("created_at")

  @@index([source])
  @@map("knowledge_chunks")
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  latinName       String   @map("latin_name")
  category        String
  location        String
  price           Decimal  @db.Decimal(12, 2)
  salePrice       Decimal? @map("sale_price") @db.Decimal(12, 2)
  stock           Int
  light           String
  watering        String
  difficulty      String
  currentHeightCm Int      @map("current_height_cm")
  maxHeightCm     Int      @map("max_height_cm")
  currentPotCm    Int      @map("current_pot_cm")
  petSafe         Boolean  @map("pet_safe")
  kidSafe         Boolean  @map("kid_safe")
  airPurifying    Boolean  @map("air_purifying")
  rating          Decimal  @db.Decimal(3, 2)
  reviewsCount    Int      @map("reviews_count")
  description     String

  @@map("products")
}

// customers — a bolt ÜGYFELEI (a lakberendező partnerei). A 03. alkalom kódba égetett
// CLIENT_PREFERENCES térképének utódja: fix három sor helyett valódi tábla, bővebb profillal.
// Az expertise_level ÉRTÉKKÉSZLETE SZÁNDÉKOSAN azonos a products.difficulty-ével, így az
// ajánlás szűrése egy egyszerű egyenlőség — nincs fordítási lépés a modell fejében.
model Customer {
  id              Int      @id @default(autoincrement())
  code            String   @unique // rövid ügyfélkód — az agent ezzel hivatkozik (pl. ACME)
  name            String // cégnév vagy magánszemély neve
  contactName     String?  @map("contact_name")
  email           String
  city            String
  customerType    String   @map("customer_type") // magánszemély | iroda | étterem | hotel | üzlet
  budget          Decimal  @db.Decimal(12, 2) // keret (HUF)
  expertiseLevel  String   @map("expertise_level") // kezdő | haladó | profi (= products.difficulty)
  petSafeRequired Boolean  @map("pet_safe_required")
  kidSafeRequired Boolean  @map("kid_safe_required")
  notes           String // döntést befolyásoló kontextus (fény, stílus, öntözési hajlandóság)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("customers")
}
