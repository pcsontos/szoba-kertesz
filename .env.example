# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API (used by the CLI agent)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI API — KIZÁRÓLAG a tudásbázis embeddingjéhez (text-embedding-3-small).
# OPCIONÁLIS: nélküle a katalógus-oldal teljesen működik, csak a searchKnowledge tool
# bukik, érthető magyar üzenettel. A HyDE és a reranker Claude Haikun megy.
OPENAI_API_KEY=

# Postgres connection strings — three privilege levels, deliberately kept apart
# (see docker-compose.yml, init.sql and the *_db_roles Prisma migration).
#
#   DATABASE_URL           admin/read-write. Prisma ONLY (schema, migrations, seed).
#                          No agent ever queries through this.
#   DATABASE_URL_READONLY  the szoba-kertesz_ro role. The query agent's runSql /
#                          listCategories tools. SELECT and nothing else.
#   DATABASE_URL_READWRITE the szoba-kertesz_rw role. The ingest agent's upsert path
#                          ONLY: SELECT + INSERT + UPDATE on products, no DELETE, no DDL.
#                          OPTIONAL — leave it out and the ask/query side still works
#                          fully; only the ingest agent fails, with a clear message.
#   DATABASE_URL_CHAT      the szoba-kertesz_chat role. The conversation store ONLY
#                          (threads + messages): SELECT + INSERT + UPDATE on those two
#                          tables and nothing else. Required by the server and by the
#                          CLI's interactive mode; the one-shot `ask` does not need it.
#
# The _ro / _rw passwords below are not secrets: the roles are created with those
# literals by the migration, which is committed. Only the admin credentials are real.
DATABASE_URL=postgresql://REPLACE_ADMIN_USER:REPLACE_ADMIN_PASSWORD@localhost:5433/szoba-kertesz
DATABASE_URL_READONLY=postgresql://szoba-kertesz_ro:szoba-kertesz_ro@localhost:5433/szoba-kertesz
DATABASE_URL_READWRITE=postgresql://szoba-kertesz_rw:szoba-kertesz_rw@localhost:5433/szoba-kertesz
DATABASE_URL_CHAT=postgresql://szoba-kertesz_chat:szoba-kertesz_chat@localhost:5433/szoba-kertesz

# Postgres container/admin credentials (used by docker-compose.yml)
POSTGRES_DB=szoba-kertesz
POSTGRES_ADMIN_USER=REPLACE_ADMIN_USER
POSTGRES_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
