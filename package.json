  "scripts": {
    "cli": "tsx --conditions=@szoba-kertesz/source apps/cli/src/main.ts",
    "szobakertesz": "nx run cli:build && node apps/cli/dist/main.js",
    "szobakertesz:debug": "nx run cli:build:development && node --inspect apps/cli/dist/main.js --show-prompt",
    "serve:api": "nx serve server",
    "serve:web": "nx dev web",
    "pr:review": "gh pr edit --add-label claude-review",
    "pr:review:off": "gh pr edit --remove-label claude-review"
  },
